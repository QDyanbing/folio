{
  "name": "gaoyanbing-folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "cd resume && astro dev --host 127.0.0.1",
    "build": "astro build --root resume",
    "preview": "cd resume && astro preview --host 127.0.0.1",
    "deploy": "node resume/scripts/deploy.mjs",
    "test": "node --test resume/tests/*.test.mjs",
    "test:site": "node resume/scripts/check-site.mjs",
    "setup:browser": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "astro": "7.4.4",
    "html2pdf.js": "^0.14.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
